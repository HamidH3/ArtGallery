# Copy this file to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for deployment.

# Supabase Dashboard → Project Settings → API (or the "Connect" button at the top of the dashboard)
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). The legacy "anon" key also works:
# if you use that instead, put it in NEXT_PUBLIC_SUPABASE_ANON_KEY and leave this empty.
# Both are designed to be public; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The address the site will live at (no trailing slash). Used for share links, the sitemap and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the service_role / secret key here or anywhere in this project. It isn't needed.
